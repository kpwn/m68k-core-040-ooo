# OR of (1 << bit) for every feature the given stage genuinely implements.
proc ::dbg::features_for_stage {stage} {
    variable FEAT_BIT
    variable FEAT_STAGE
    set value 0
    foreach name [array names FEAT_BIT] {
        if {$FEAT_STAGE($name) <= $stage} {
            set value [expr {$value | (1 << $FEAT_BIT($name))}]
        }
    }
    return $value
}
