target/
project/target/
project/project/
.bsp/
.coursier/
simWorkspace/
generated/
*.fst
*.vcd
hs_err_pid*.log
.idea/
.metals/
.bloop/
/.agent-reservation
# stray root-level Verilog from elaboration tests that don't set a target dir
/*.v
unnamed.v
# Vivado / synthesis artifacts (keep scripts in synth/, ignore outputs)
synth/*.rpt
synth/*.log
synth/*.jou
synth/*.dcp
# Raw Vivado transcripts from synth/run_walker_dcache_gate.sh. The distilled
# `*.summary` beside each one IS committed -- that is the gate evidence.
synth/*.out
# Archived gate evidence keeps its .rpt/.out files (they are the durable record) but
# never its checkpoints: a synth+routed DCP pair is ~85 MB per arm, is regenerable from
# the pinned netlist md5 recorded alongside it, and no .dcp has ever been tracked here.
synth/archive/**/*.dcp
synth/fullcore_synth.md5
# Generated by impl_FullCore.tcl when IMPL_PROBE_PERIOD_NS is set. The committed
# constraint is synth/clk.xdc (5.000ns); this file is a transient measurement artifact
# and must never be mistaken for the spec.
synth/clk_probe.xdc
# Router byproduct dropped in the CWD; impl_FullCore.tcl copies the useful content to
# synth/fullcore_congested_nets.txt, which is itself a regenerable report.
iter_100_CongestedCLBsAndNets.txt
synth/fullcore_congested_nets.txt
clockInfo.txt
.Xil/
vivado*.log
vivado*.jou
cong/
synth/vivado_*.log
bench_logs/

# --- 2026-09-05 audit: ~38 MB of derived artifacts were sitting untracked ---
# Python bytecode from tools/
__pycache__/
# Vivado stdout transcripts. Same rule as synth/*.out above: the distilled
# *.summary beside them is the committed evidence, the raw transcript is not.
synth/*.stdout
# Pinned/archived build products and gate scratch dirs -- large and regenerable
# from the netlist md5 recorded alongside each gate result.
synth/pinned/
synth/fpucore_gate/
# Fuzz and ported-test run logs. The triage conclusions are written up in
# docs/superpowers/specs/; these are the raw per-seed transcripts behind them.
fuzz_logs*/
ported_logs_*/
# ROM disassembly -- 13 MB, regenerable from files/*.rom
*.dis
